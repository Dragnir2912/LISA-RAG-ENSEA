FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/lisa

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-server.txt ./
RUN pip install --upgrade pip && pip install -r requirements-server.txt

COPY backend backend
COPY frontend frontend
COPY src src
COPY scripts scripts
COPY config.yaml ./config.yaml
COPY deployment/backend-entrypoint.sh /usr/local/bin/lisa-entrypoint
COPY deployment/prefetch_models.py /srv/lisa/deployment/prefetch_models.py
RUN chmod 0555 /usr/local/bin/lisa-entrypoint

RUN mkdir -p /srv/lisa/data/app /srv/lisa/data/uploads

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/lisa-entrypoint"]
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers", "--forwarded-allow-ips", "*"]
