# Copiez ce fichier vers .env.local sur la machine de développement.
LISA_ENV_FILE=.env.local
LISA_IMAGE_TAG=local
POSTGRES_DB=lisa_rag
POSTGRES_USER=lisa
LISA_HTTP_PORT=8080

RAG_ENV=development
RAG_PUBLIC_URL=http://localhost:8080
RAG_TRUSTED_HOSTS=localhost,127.0.0.1
RAG_ALLOWED_ORIGINS=http://localhost:8080
RAG_COOKIE_SECURE=0
RAG_SELF_REGISTRATION=1
RAG_GUEST_ACCESS=1
RAG_PASSWORD_RESET=1
RAG_PASSWORD_RESET_PREVIEW=1
RAG_SESSION_DAYS=7
RAG_GUEST_SESSION_HOURS=8
RAG_GUEST_DATA_DAYS=7

# Fonctionne sans carte graphique. Pour NVIDIA, utilisez compose.gpu.yaml et
# remplacez les deux valeurs ci-dessous par 0 et 999.
RAG_FORCE_CPU=1
RAG_OLLAMA_NUM_GPU=0
RAG_OFFLINE_MODE=1

APIFY_TOKEN=
RAG_SMTP_HOST=
RAG_SMTP_PORT=587
RAG_SMTP_USERNAME=
RAG_SMTP_PASSWORD=
RAG_SMTP_FROM=LISA <noreply@localhost>
