# Copiez ce fichier vers .env.test sur le serveur Linux.
LISA_ENV_FILE=.env.test
LISA_IMAGE_TAG=test
POSTGRES_DB=lisa_rag
POSTGRES_USER=lisa
LISA_HTTP_PORT=8080
LISA_DOMAIN=lisa-test.example.org

RAG_ENV=staging
RAG_PUBLIC_URL=https://lisa-test.example.org
RAG_TRUSTED_HOSTS=lisa-test.example.org
RAG_ALLOWED_ORIGINS=https://lisa-test.example.org
RAG_COOKIE_SECURE=1
RAG_SELF_REGISTRATION=1
RAG_GUEST_ACCESS=1
RAG_PASSWORD_RESET=1
RAG_PASSWORD_RESET_PREVIEW=0
RAG_SESSION_DAYS=7
RAG_GUEST_SESSION_HOURS=8
RAG_GUEST_DATA_DAYS=7

# Profil portable et indépendant du GPU.
RAG_FORCE_CPU=1
RAG_OLLAMA_NUM_GPU=0

# Le cœur conversationnel, les PDF et les index restent 100 % locaux.
# Passez temporairement à 0 uniquement pour lancer une collecte Web/Facebook.
RAG_OFFLINE_MODE=1

# Facultatif et uniquement utile quand RAG_OFFLINE_MODE=0.
APIFY_TOKEN=

# Facultatif : un relais SMTP exige une connectivité réseau.
RAG_SMTP_HOST=
RAG_SMTP_PORT=587
RAG_SMTP_USERNAME=
RAG_SMTP_PASSWORD=
RAG_SMTP_FROM=LISA <noreply@example.org>
